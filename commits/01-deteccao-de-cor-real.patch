+describe('Color Detection - amostra reduzida e região', () => {
+  function imageWithCenter(
+    size: number,
+    background: [number, number, number],
+    center: [number, number, number],
+    centerHalfSize: number
+  ): Uint8ClampedArray {
+    const data = new Uint8ClampedArray(size * size * 4);
+    const mid = Math.floor(size / 2);
+    for (let y = 0; y < size; y++) {
+      for (let x = 0; x < size; x++) {
+        const inCenter = Math.abs(x - mid) < centerHalfSize && Math.abs(y - mid) < centerHalfSize;
+        const [r, g, b] = inCenter ? center : background;
+        const index = (y * size + x) * 4;
+        data[index] = r;
+        data[index + 1] = g;
+        data[index + 2] = b;
+        data[index + 3] = 255;
+      }
+    }
+    return data;
+  }
+
+  it('should name #595959 as Cinza Escuro and keep it darker than Cinza', () => {
+    const dark = detectColorFromImageData(imageWithCenter(32, [89, 89, 89], [89, 89, 89], 4), 32, 32);
+    const gray = detectColorFromImageData(imageWithCenter(32, [128, 128, 128], [128, 128, 128], 4), 32, 32);
+    expect(dark.name).toBe('Cinza Escuro');
+    expect(gray.name).toBe('Cinza');
+    expect(dark.rgb.r).toBeLessThan(gray.rgb.r);
+  });
+
+  it('should not report the old light gray (#A9A9A9) as Cinza Escuro', () => {
+    const result = detectColorFromImageData(imageWithCenter(32, [169, 169, 169], [169, 169, 169], 4), 32, 32);
+    expect(result.name).not.toBe('Cinza Escuro');
+  });
+
+  it('should read only the center when the region radius is small', () => {
+    // Fundo preto com um quadrado vermelho no centro
+    const image = imageWithCenter(40, [0, 0, 0], [255, 0, 0], 4);
+    const result = detectColorFromImageData(image, 40, 40, undefined, undefined, 3);
+    expect(result.rgb).toEqual({ r: 255, g: 0, b: 0 });
+    expect(result.name).toBe('Vermelho');
+  });
+
+  it('should mix in the background when the region radius is large', () => {
+    const image = imageWithCenter(40, [0, 0, 0], [255, 0, 0], 4);
+    const small = detectColorFromImageData(image, 40, 40, undefined, undefined, 3);
+    const large = detectColorFromImageData(image, 40, 40, undefined, undefined, 20);
+    expect(large.rgb.r).toBeLessThan(small.rgb.r);
+  });
+
+  it('should keep the default region radius of 15 when none is given', () => {
+    const image = imageWithCenter(40, [0, 0, 0], [255, 0, 0], 4);
+    const implicit = detectColorFromImageData(image, 40, 40);
+    const explicit = detectColorFromImageData(image, 40, 40, undefined, undefined, 15);
+    expect(implicit).toEqual(explicit);
+  });
+});
